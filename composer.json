{
    "name": "portal-jogos/api",
    "description": "RESTful API backend engine for the Game Portal, managing player authentication, game catalog, player profiles, wallet/transactions, leaderboards, and game sessions using CodeIgniter 4.",
    "version": "1.3.1",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "game-portal",
        "rest-api",
        "codeigniter4",
        "shield",
        "player-auth",
        "games"
    ],
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
